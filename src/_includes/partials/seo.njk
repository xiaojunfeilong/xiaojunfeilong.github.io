{%- set pageTitle = title + " · " + site.name if title else site.name + " · " + site.tagline -%}
{%- set pageDescription = description or excerpt or site.description -%}
{%- set canonical = page.url | absoluteUrl -%}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="{{ site.author }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="#0e0d0a">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:image" content="{{ '/assets/og.svg' | absoluteUrl }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if layout == 'layouts/post.njk' %}Article{% else %}WebSite{% endif %}",
  "name": {{ pageTitle | dump | safe }},
  "headline": {{ (title or site.name) | dump | safe }},
  "description": {{ pageDescription | dump | safe }},
  "url": {{ canonical | dump | safe }},
  "inLanguage": "{{ site.language }}",
  "author": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }}
  }
}
</script>
