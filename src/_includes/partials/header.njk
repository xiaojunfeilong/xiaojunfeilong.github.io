<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }} 首页">
      <span class="brand-mark" aria-hidden="true">榆</span>
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-tagline">{{ site.tagline }}</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="visually-hidden">打开导航菜单</span>
    </button>
    <nav id="site-nav" class="site-nav" data-nav aria-label="主导航">
      <ul class="nav-list">
        {%- for item in site.nav %}
        <li>
          <a
            href="{{ item.url | url }}"
            {% if page.url == item.url %}aria-current="page"{% endif %}
          >{{ item.label }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
